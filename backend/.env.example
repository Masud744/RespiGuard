# ==============================================================================
# RespiGuard Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in project root (or backend/.env)
# 2. Fill in your own credentials below.
# 3. NEVER commit your real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Database (REQUIRED)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_jwt_key_here

# ------------------------------------------------------------------------------
# 2. Gmail SMTP & IMAP Email Service (REQUIRED FOR EMAIL / OPTIONAL FOR LOCAL TESTING)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Inbound email listener (optional: defaults to imap.gmail.com:993 and reuses SMTP credentials)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USER=your_email@gmail.com
# IMAP_PASSWORD=your_16_character_google_app_password
